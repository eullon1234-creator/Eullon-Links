{
  "manifest_version": 3,
  "name": "Eullon Links",
  "version": "1.0.0",
  "description": "Salve e organize seus links favoritos com tags, notas, prioridades e sincronização no Firebase.",
  "permissions": [
    "activeTab",
    "tabs"
  ],
  "action": {
    "default_popup": "index.html?popup=true",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
